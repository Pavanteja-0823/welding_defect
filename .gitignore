# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual Environment
venv/
env/
.env/
.venv/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
nul

# Model weights (large files — use Git LFS or download separately)
runs/detect/*/weights/*.pt
runs/detect/*/weights/*.onnx
runs/detect/*/weights/*.onnx.data
*.pt
!yolov8n.pt

# Training artifacts (regenerated each run)
runs/detect/train*/
runs/detect/predict*/
runs/detect/welding_defect_model/
runs/detect/welding_defect_model2/
runs/detect/welding_defect_model3/
runs/detect/welding_defect_model4/
runs/detect/welding_defect_model5/

# Keep the production model folder structure
!runs/detect/welding_defect_model6/
!runs/detect/welding_defect_model6/weights/
!runs/detect/welding_defect_model6/weights/best.onnx
!runs/detect/welding_defect_model6/weights/best.onnx.data

# Uploads (user-uploaded images at runtime)
uploads/
uploads/*

# Logs
*.log
server.log

# Dataset images (too large for git — download separately)
dataset/train/images/
dataset/valid/images/
dataset/test/images/
dataset/train/labels/
dataset/valid/labels/
dataset/test/labels/

# Environment variables
.env
.env.local
.env.production

# Docker
.dockerignore
